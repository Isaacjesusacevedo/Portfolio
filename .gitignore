# ============================================
# Portfolio Personal — Isaac Acevedo
# Archivos y carpetas ignoradas por Git
# ============================================

# --------------------------------------------
# 1. Archivos del sistema operativo
# --------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux
*~
.nfs*

# --------------------------------------------
# 2. Archivos de editores y IDEs
# --------------------------------------------

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Sublime Text
*.sublime-project
*.sublime-workspace

# JetBrains (WebStorm, PhpStorm, etc.)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*~

# --------------------------------------------
# 3. Archivos de logs y temporales
# --------------------------------------------

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------------------------
# 4. Archivos de dependencias (por si agregás Node.js en el futuro)
# --------------------------------------------

node_modules/
npm-shrinkwrap.json
package-lock.json
yarn.lock
.pnp.*

# --------------------------------------------
# 5. Archivos de build y distribución
# --------------------------------------------

dist/
build/
.cache/

# --------------------------------------------
# 6. Archivos de entorno y configuración local
# --------------------------------------------

.env
.env.local
.env.*.local

# --------------------------------------------
# 7. Archivos de respaldo
# --------------------------------------------

*.bak
*.backup
*.old
*.orig

# --------------------------------------------
# 8. Archivos comprimidos (si los generás localmente)
# --------------------------------------------

*.zip
*.rar
*.7z
*.tar.gz
